.pytest_cache/
.coverage
htmlcov/

# Streamlit local config & cache
.streamlit/
.streamlit/secrets.toml

# IDEs & Editor directories
.vscode/
.idea/
*.swp
*.swo

# OS Generated files
.DS_Store
Thumbs.db
