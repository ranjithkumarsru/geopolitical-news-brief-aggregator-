# ==========================================
# Geopolitical News Brief Aggregator - Environment Configuration
# ==========================================

# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/
# If left blank, the application safely operates using heuristic strategic analysis fallback.
GEMINI_API_KEY=

# Gemini Model Identifier (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Location
DATABASE_PATH=data/geopolitical_news.db

# Deduplication Jaccard Similarity Threshold (0.0 to 1.0)
DEDUPLICATION_THRESHOLD=0.72

# Ingestion Settings
MAX_ARTICLES_PER_FEED=15
REQUEST_TIMEOUT_SECONDS=12
